# GEMINI_API_KEY: Required for Gemini AI API calls on the backend server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL: The Gemini model to use (e.g. gemini-3.8-flash, gemini-4-argon)
GEMINI_MODEL="gemini-3.8-flash"

# SUPABASE_URL: The URL of your Supabase project (e.g. https://your-project.supabase.co)
SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_ANON_KEY: The public anon key for your Supabase project (safe for client queries with RLS)
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Server Port
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
